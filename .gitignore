# -----------------------------------------------------------------------------
# Scanly .gitignore
# Ignore local machine noise and generated data — do not strip shared project
# assets that are already versioned (e.g. screenshots/, shared .idea config).
# -----------------------------------------------------------------------------

# Product UI screenshots used by README.md — always keep versioned.
# (Explicitly allow-listed so no broad pattern can hide them.)
!/screenshots/
!/screenshots/**

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Secrets & local machine config (never commit) ---
local.properties
**/local.properties
*.jks
*.keystore
*.p12
*.pem
*.key
keystore/
**/keystore.properties
google-services.json
**/google-services.json
**/secrets.properties

# --- Gradle / Android build ---
.gradle/
build/
**/build/
.externalNativeBuild/
.cxx/
**/captures/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
**/release/
# Android Studio "Generate Signed Bundle / APK" drops artifacts here.
# Do not ignore app/src/githubRelease/ or app/src/playStoreRelease/ (source).
/app/githubRelease/
/app/playStoreRelease/
*.hprof
*.log
*.mapping
build_output.txt
/build_output.txt

# --- IDE personal state (shared project .idea files stay tracked if already in git) ---
*.iml
.idea/
.vscode/
*.swp
*.swo
*~

# --- Kotlin / compiler caches and error dumps (never source) ---
.kotlin/
**/.kotlin/

# --- Agent / session / terminal dumps (local only) ---
.codex/
**/.codex/
.agents/
.claude/
.cursor/
.grok/
terminals/
/terminals/
tmp/
/tmp/
/output/

# --- Python (training notebooks) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
.env.*

# --- Notebooks: ignore audit dumps and caches, not necessarily all notebooks ---
notebooks/__pycache__/
notebooks/tools-audit/
notebooks/tools-audit-*.png
notebooks/.ipynb_checkpoints/
/notebooks/scanly_doccorner_mobilenetv3_kaggle.py
/notebooks/scanly_doccorner_mobilenetv3_kaggle.ipynb
/notebooks/scanly_document_gate_kaggle.ipynb
/notebooks/scanly_document_gate_kaggle.py

# --- Performance seed generated data (directory rules, not per-file lists) ---
/scripts/performance-seed/.cache/
/scripts/performance-seed/.staging/
/scripts/performance-seed/**/seed-output/

# --- ML model assets ---
# Large .tflite binaries stay out of casual commits. Already-tracked models remain
# in the index; ship new ones with: git add -f app/src/main/assets/models/<name>.tflite
/app/src/main/assets/models/*.tflite
app/src/main/assets/models/*.tflite

# --- Validation fixtures (local only) ---
/app/src/main/assets/validation/images/*.jpg
/app/src/main/assets/validation/images/*.jpeg
/app/src/main/assets/validation/images/*.png
/app/src/main/assets/validation/images/*.bmp
/app/src/main/assets/validation/images/*.webp
/app/src/main/assets/validation/expected/*.corners.json
/app/src/main/assets/adi-registration.properties

# --- Misc local dumps ---
*.orig
*.rej
*.tmp
*.temp
*.bak
.cache/
**/.cache/
