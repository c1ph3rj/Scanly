<?xml version="1.0" encoding="utf-8"?>
<!--
   Used only on Android 10 and 11 (API 29-30), where Auto Backup reads this file.
   Scanly excludes all app data so nothing is copied to Google Drive.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
